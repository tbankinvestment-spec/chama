<div style="max-width: 560px; margin: 40px auto;">
    <div style="background: #fff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="background: linear-gradient(135deg, #1e3a5f 0%, #2c5282 100%); padding: 28px 30px; color: #fff;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                <a href="/register" style="color: #fff; opacity: 0.85; text-decoration: none; font-size: 14px;">← Cancel & Return</a>
            </div>
            <h1 style="font-size: 24px; margin-bottom: 4px;">Verify Your Account</h1>
            <p style="opacity: 0.85; font-size: 14px;">Secure your account by verifying your email and phone number</p>
        </div>

        <div style="padding: 32px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px;">
                <div id="step1Marker" style="display: flex; align-items: center; gap: 10px; flex: 1;">
                    <div style="width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, #38b2ac 0%, #319795 100%); color: #fff; font-weight: 700; font-size: 14px; display: flex; align-items: center; justify-content: center;">1</div>
                    <div>
                        <div style="font-size: 13px; font-weight: 700; color: #2d3748;">Email Verification</div>
                        <div id="step1Status" style="font-size: 12px; color: #319795; font-weight: 600;">{{#if emailVerified}}Verified ✓{{else}}Pending{{/if}}</div>
                    </div>
                </div>
                <div style="flex: 1; height: 2px; margin: 0 12px; background: #edf2f7; position: relative;">
                    <div id="progressBar" style="position: absolute; top: 0; left: 0; height: 100%; width: {{#if emailVerified}}100%{{else}}0%{{/if}}; background: linear-gradient(90deg, #4fd1c5, #319795); transition: width 0.3s;"></div>
                </div>
                <div id="step2Marker" style="display: flex; align-items: center; gap: 10px; flex: 1;">
                    <div id="step2Circle" style="width: 34px; height: 34px; border-radius: 50%; {{#if emailVerified}}background: linear-gradient(135deg, #38b2ac 0%, #319795 100%); color: #fff;{{else}}background: #edf2f7; color: #a0aec0;{{/if}} font-weight: 700; font-size: 14px; display: flex; align-items: center; justify-content: center; transition: all 0.3s;">2</div>
                    <div>
                        <div style="font-size: 13px; font-weight: 700; color: #2d3748;">Phone Verification</div>
                        <div id="step2Status" style="font-size: 12px; color: {{#if phoneVerified}}#38a169{{else}}#a0aec0{{/if}}; font-weight: 600;">{{#if phoneVerified}}Verified ✓{{else}}Locked{{/if}}</div>
                    </div>
                </div>
            </div>

            <div id="step1Panel">
                <div style="background: #ebf8ff; border: 1.5px solid #bee3f8; border-radius: 10px; padding: 16px 18px; margin-bottom: 22px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 36px; height: 36px; background: #fff; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px;">✉️</div>
                        <div>
                            <div style="font-size: 13px; font-weight: 700; color: #2c5282;">Verification code will be sent to</div>
                            <div style="font-size: 15px; font-weight: 600; color: #1a365d;">{{user.email}}</div>
                        </div>
                    </div>
                </div>

                {{#if emailVerified}}
                    <div style="background: #f0fff4; border: 1.5px solid #9ae6b4; border-radius: 8px; padding: 12px 16px; color: #22543d; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                        <span>✅</span>
                        <span>Email address verified successfully.</span>
                    </div>
                {{else}}
                    <!-- Send button form: displayed initially, hidden once clicked or once code is sent -->
                    <form method="POST" action="/verify/email/send" id="emailSendForm" style="{{#if emailCodeSent}}display:none;{{else}}display:block;{{/if}}" onsubmit="handleEmailSend(event)">
                        <button type="submit" id="emailSendBtn"
                            style="width: 100%; padding: 12px; background: linear-gradient(135deg, #38b2ac 0%, #319795 100%); color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; transition: transform 0.1s, box-shadow 0.2s;"
                            onmouseover="this.style.boxShadow='0 4px 12px rgba(56,178,172,0.4)'"
                            onmouseout="this.style.boxShadow='none';this.style.transform='scale(1)'"
                            onmousedown="this.style.transform='scale(0.98)'"
                            onmouseup="this.style.transform='scale(1)'">
                            Send Verification Code
                        </button>
                        {{#if errors.emailSend}}<p style="margin: 8px 2px 0 2px; font-size: 13px; color: #e53e3e;">{{errors.emailSend}}</p>{{/if}}
                        {{#if messages.emailSend}}<p style="margin: 8px 2px 0 2px; font-size: 13px; color: #38a169; font-weight: 600;">{{messages.emailSend}}</p>{{/if}}
                    </form>

                    <!-- Input panel: displayed when code is sent OR immediately when Send is clicked -->
                    <div id="emailVerifyPanel" style="{{#if emailCodeSent}}display:block;{{else}}display:none;{{/if}}">
                        <div style="margin-top: 14px;">
                            <label style="display: block; font-size: 14px; font-weight: 600; color: #2d3748; margin-bottom: 6px;">Enter Email Verification Code</label>
                            <form method="POST" action="/verify/email/check" id="emailCheckForm" style="display: flex; gap: 10px; align-items: flex-start;" onsubmit="handleEmailCheck(event)">
                                <input type="text" name="emailCode" id="emailCodeInput" maxlength="6" inputmode="numeric" placeholder="Enter 1234" required
                                    autocomplete="one-time-code" spellcheck="false" autocorrect="off"
                                    style="flex: 1; height: 48px; padding: 0 16px; box-sizing: border-box; border: 1.5px solid {{#if errors.emailCheck}}#fc8181{{else}}#e2e8f0{{/if}}; border-radius: 8px; font-size: 18px; letter-spacing: 8px; text-align: center; outline: none; transition: border-color 0.2s;"
                                    onfocus="this.style.borderColor='#4fd1c5'" onblur="this.style.borderColor='{{#if errors.emailCheck}}#fc8181{{else}}#e2e8f0{{/if}}'"
                                    onkeydown="return restrictDigitKeys(event)"
                                    oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,6)">
                                <button type="submit" id="emailVerifyBtn"
                                    style="height: 48px; padding: 0 20px; background: #fff; border: 1.5px solid #319795; color: #319795; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; transition: background 0.2s, color 0.2s;"
                                    onmouseover="this.style.background='#319795';this.style.color='#fff'"
                                    onmouseout="this.style.background='#fff';this.style.color='#319795'">
                                    Verify
                                </button>
                            </form>
                            <div style="font-size: 12px; color: #718096; margin-top: 6px;">Verification key: <strong style="color: #319795;">1234</strong></div>
                            {{#if errors.emailCheck}}<p style="margin: 8px 2px 0 2px; font-size: 13px; color: #e53e3e;">{{errors.emailCheck}}</p>{{/if}}
                            <div style="margin-top: 10px;">
                                <button type="button" onclick="handleEmailSend(event)" style="background: none; border: none; padding: 0; font-size: 13px; color: #319795; font-weight: 600; cursor: pointer; text-decoration: underline;">Didn't receive the code? Resend</button>
                            </div>
                        </div>
                    </div>
                {{/if}}
            </div>

            <div id="step2Panel" {{#unless emailVerified}}style="display: none; opacity: 0.5; pointer-events: none;"{{/unless}}>
                <div style="background: #f0fff4; border: 1.5px solid #c6f6d5; border-radius: 10px; padding: 16px 18px; margin: 28px 0 22px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 36px; height: 36px; background: #fff; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px;">📱</div>
                        <div>
                            <div style="font-size: 13px; font-weight: 700; color: #22543d;">SMS verification number will be sent to</div>
                            <div style="font-size: 15px; font-weight: 600; color: #22543d;">{{#if user.phone}}{{user.phone}}{{else}}+254 (add phone first){{/if}}</div>
                        </div>
                    </div>
                </div>

                {{#if phoneVerified}}
                    <div style="background: #f0fff4; border: 1.5px solid #9ae6b4; border-radius: 8px; padding: 12px 16px; color: #22543d; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                        <span>✅</span>
                        <span>Phone number verified successfully.</span>
                    </div>
                {{else}}
                    <!-- Send button form: hidden once code is sent OR when email is verified (since SMS 1234 is auto-prepared) -->
                    <form method="POST" action="/verify/phone/send" id="phoneSendForm" style="{{#if phoneCodeSent}}display:none;{{else}}{{#if emailVerified}}display:none;{{else}}display:block;{{/if}}{{/if}}" onsubmit="handlePhoneSend(event)">
                        <button type="submit" id="phoneSendBtn"
                            style="width: 100%; padding: 12px; background: linear-gradient(135deg, #38b2ac 0%, #319795 100%); color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; transition: transform 0.1s, box-shadow 0.2s;"
                            onmouseover="this.style.boxShadow='0 4px 12px rgba(56,178,172,0.4)'"
                            onmouseout="this.style.boxShadow='none';this.style.transform='scale(1)'"
                            onmousedown="this.style.transform='scale(0.98)'"
                            onmouseup="this.style.transform='scale(1)'">
                            Send SMS Verification Number
                        </button>
                        {{#if errors.phoneSend}}<p style="margin: 8px 2px 0 2px; font-size: 13px; color: #e53e3e;">{{errors.phoneSend}}</p>{{/if}}
                        {{#if messages.phoneSend}}<p style="margin: 8px 2px 0 2px; font-size: 13px; color: #38a169; font-weight: 600;">{{messages.phoneSend}}</p>{{/if}}
                    </form>

                    <!-- Input panel: displayed when code is sent OR immediately when email is verified -->
                    <div id="phoneVerifyPanel" style="{{#if phoneCodeSent}}display:block;{{else}}{{#if emailVerified}}display:block;{{else}}display:none;{{/if}}{{/if}}">
                        <div style="margin-top: 14px;">
                            <label style="display: block; font-size: 14px; font-weight: 600; color: #2d3748; margin-bottom: 6px;">Enter SMS Verification Number</label>
                            <form method="POST" action="/verify/phone/check" id="phoneCheckForm" style="display: flex; gap: 10px; align-items: flex-start;" onsubmit="handlePhoneCheck(event)">
                                <input type="text" name="phoneCode" id="phoneCodeInput" maxlength="6" inputmode="numeric" placeholder="Enter 1234" required
                                    autocomplete="one-time-code" spellcheck="false" autocorrect="off"
                                    style="flex: 1; height: 48px; padding: 0 16px; box-sizing: border-box; border: 1.5px solid {{#if errors.phoneCheck}}#fc8181{{else}}#e2e8f0{{/if}}; border-radius: 8px; font-size: 18px; letter-spacing: 8px; text-align: center; outline: none; transition: border-color 0.2s;"
                                    onfocus="this.style.borderColor='#4fd1c5'" onblur="this.style.borderColor='{{#if errors.phoneCheck}}#fc8181{{else}}#e2e8f0{{/if}}'"
                                    onkeydown="return restrictDigitKeys(event)"
                                    oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,6)">
                                <button type="submit" id="phoneVerifyBtn"
                                    style="height: 48px; padding: 0 20px; background: #fff; border: 1.5px solid #319795; color: #319795; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; transition: background 0.2s, color 0.2s;"
                                    onmouseover="this.style.background='#319795';this.style.color='#fff'"
                                    onmouseout="this.style.background='#fff';this.style.color='#319795'">
                                    Verify
                                </button>
                            </form>
                            <div style="font-size: 12px; color: #718096; margin-top: 6px;">Verification key: <strong style="color: #319795;">1234</strong></div>
                            {{#if errors.phoneCheck}}<p style="margin: 8px 2px 0 2px; font-size: 13px; color: #e53e3e;">{{errors.phoneCheck}}</p>{{/if}}
                            <div style="margin-top: 10px;">
                                <button type="button" onclick="handlePhoneSend(event)" style="background: none; border: none; padding: 0; font-size: 13px; color: #319795; font-weight: 600; cursor: pointer; text-decoration: underline;">Didn't receive the SMS? Resend</button>
                            </div>
                        </div>
                    </div>
                {{/if}}

                {{#if bothVerified}}
                <div style="margin-top: 28px; background: #f0fff4; border: 1.5px solid #9ae6b4; border-radius: 10px; padding: 18px; text-align: center;">
                    <div style="font-size: 36px; margin-bottom: 6px;">✅</div>
                    <div style="font-size: 17px; font-weight: 700; color: #22543d; margin-bottom: 4px;">Account Verified!</div>
                    <div style="font-size: 13px; color: #276749; margin-bottom: 14px;">Both your email and phone number have been verified successfully.</div>
                    <a href="/login"
                        style="display: inline-block; padding: 10px 22px; background: linear-gradient(135deg, #38b2ac 0%, #319795 100%); color: #fff; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none;">
                        Proceed to Sign In →
                    </a>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>

<script>
async function handleEmailSend(e) {
    if (e && e.preventDefault) e.preventDefault();
    var form = document.getElementById('emailSendForm');
    var panel = document.getElementById('emailVerifyPanel');
    var input = document.getElementById('emailCodeInput');
    if (form) form.style.display = 'none';
    if (panel) panel.style.display = 'block';
    if (input) {
        setTimeout(function() { input.focus(); }, 50);
    }

    try {
        await fetch('/verify/email/send', {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        });
    } catch (err) {
        console.warn('Email dispatch background error:', err);
    }
}

async function handleEmailCheck(e) {
    if (e && e.preventDefault) e.preventDefault();
    var input = document.getElementById('emailCodeInput');
    var code = (input ? input.value : '').trim();
    if (!code) return;

    var btn = document.getElementById('emailVerifyBtn') || (e.target && e.target.querySelector('button[type="submit"]'));
    if (btn) {
        btn.disabled = true;
        btn.textContent = 'Verifying...';
    }

    try {
        var resp = await fetch('/verify/email/check', {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ emailCode: code })
        });
        var data = await resp.json();
        if (data.success && data.emailVerified) {
            // Update Step 1 marker and status
            var step1Status = document.getElementById('step1Status');
            if (step1Status) step1Status.innerHTML = 'Verified ✓';
            var progressBar = document.getElementById('progressBar');
            if (progressBar) progressBar.style.width = '100%';
            var emailPanel = document.getElementById('step1Panel');
            if (emailPanel) {
                emailPanel.innerHTML = '<div style="background: #f0fff4; border: 1.5px solid #9ae6b4; border-radius: 8px; padding: 12px 16px; color: #22543d; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px;"><span>✅</span><span>Email address verified successfully.</span></div>';
            }

            // Unlock and activate Step 2 panel
            var step2Panel = document.getElementById('step2Panel');
            if (step2Panel) {
                step2Panel.style.display = 'block';
                step2Panel.style.opacity = '1';
                step2Panel.style.pointerEvents = 'auto';
            }
            var step2Circle = document.getElementById('step2Circle');
            if (step2Circle) {
                step2Circle.style.background = 'linear-gradient(135deg, #38b2ac 0%, #319795 100%)';
                step2Circle.style.color = '#fff';
            }
            var step2Status = document.getElementById('step2Status');
            if (step2Status) {
                step2Status.innerHTML = 'Ready';
                step2Status.style.color = '#319795';
            }

            // Immediately display SMS input panel for 1234
            var phoneSendForm = document.getElementById('phoneSendForm');
            if (phoneSendForm) phoneSendForm.style.display = 'none';
            var phoneVerifyPanel = document.getElementById('phoneVerifyPanel');
            if (phoneVerifyPanel) phoneVerifyPanel.style.display = 'block';

            var phoneInput = document.getElementById('phoneCodeInput');
            if (phoneInput) {
                setTimeout(function() { phoneInput.focus(); }, 80);
            }
            return;
        } else if (data.error) {
            alert(data.error);
            if (btn) { btn.disabled = false; btn.textContent = 'Verify'; }
            return;
        }
    } catch (err) {
        console.warn('AJAX check error, fallback to form submit:', err);
    }
    // Fallback to standard form submission
    if (e && e.target && e.target.submit) {
        e.target.submit();
    }
}

async function handlePhoneSend(e) {
    if (e && e.preventDefault) e.preventDefault();
    var form = document.getElementById('phoneSendForm');
    var panel = document.getElementById('phoneVerifyPanel');
    var input = document.getElementById('phoneCodeInput');
    if (form) form.style.display = 'none';
    if (panel) panel.style.display = 'block';
    if (input) {
        setTimeout(function() { input.focus(); }, 50);
    }

    try {
        await fetch('/verify/phone/send', {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        });
    } catch (err) {
        console.warn('Phone dispatch background error:', err);
    }
}

async function handlePhoneCheck(e) {
    if (e && e.preventDefault) e.preventDefault();
    var input = document.getElementById('phoneCodeInput');
    var code = (input ? input.value : '').trim();
    if (!code) return;

    var btn = document.getElementById('phoneVerifyBtn') || (e.target && e.target.querySelector('button[type="submit"]'));
    if (btn) {
        btn.disabled = true;
        btn.textContent = 'Saving...';
    }

    try {
        var resp = await fetch('/verify/phone/check', {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ phoneCode: code })
        });
        var data = await resp.json();
        if (data.redirect) {
            window.location.href = data.redirect;
            return;
        }
        if (data.success) {
            window.location.href = '/login';
            return;
        }
        if (data.error) {
            alert(data.error);
            if (btn) { btn.disabled = false; btn.textContent = 'Verify'; }
            return;
        }
    } catch (err) {
        console.warn('AJAX phone check fallback to submit:', err);
    }
    // Fallback to standard form submission
    if (e && e.target && e.target.submit) {
        e.target.submit();
    }
}

function restrictDigitKeys(e) {
    var k = e.key;
    if (e.ctrlKey || e.metaKey) return true;
    if (['Backspace','Delete','ArrowLeft','ArrowRight','Tab','Enter','Home','End'].includes(k)) return true;
    if (/^[0-9]$/.test(k)) {
        var target = e.target;
        if (target && target.value && target.value.length >= 6) {
            e.preventDefault();
            return false;
        }
        return true;
    }
    e.preventDefault();
    return false;
}

document.addEventListener('DOMContentLoaded', function() {
    var phoneInput = document.getElementById('phoneCodeInput');
    if (phoneInput && {{#if emailVerified}}{{#unless phoneVerified}}true{{else}}false{{/unless}}{{else}}false{{/if}}) {
        setTimeout(function() { phoneInput.focus(); }, 150);
    }
});
</script>
