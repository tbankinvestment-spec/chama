{{!-- views/login.hbs — Login + Account Activation (Steps 5-8) --}}
<style>
  :root {
    --bg: #f0f2f5;
    --card: #ffffff;
    --text: #2d3748;
    --muted: #718096;
    --brand: #319795;
    --brand-hover: #2c7a7b;
    --brand-gradient: linear-gradient(135deg, #38b2ac 0%, #319795 100%);
    --brand-focus: #4fd1c5;
    --navy: #1e3a5f;
    --navy-gradient: linear-gradient(135deg, #1e3a5f 0%, #2c5282 100%);
    --err: #c53030;
    --err-border: #fc8181;
    --err-bg: #fff5f5;
    --line: #e2e8f0;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121824;
      --card: #1a2332;
      --text: #f7fafc;
      --muted: #a0aec0;
      --brand: #4fd1c5;
      --brand-hover: #38b2ac;
      --brand-gradient: linear-gradient(135deg, #4fd1c5 0%, #319795 100%);
      --brand-focus: #38b2ac;
      --navy: #63b3ed;
      --navy-gradient: linear-gradient(135deg, #2c5282 0%, #1e3a5f 100%);
      --err: #feb2b2;
      --err-border: #fc8181;
      --err-bg: rgba(229, 62, 62, 0.15);
      --line: #2d3748;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    min-height: 100vh;
  }
  .wrap { max-width: 480px; margin: 40px auto 60px; padding: 0 16px; }
  .card {
    background: var(--card);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .card-header {
    background: var(--navy-gradient);
    padding: 28px 24px 22px;
    text-align: center;
    color: #ffffff;
  }
  .card-header .logo { font-size: 26px; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 8px; color: #ffffff; }
  .card-header .logo span { color: #4fd1c5; }
  .card-header h1 { font-size: 1.45rem; margin: 0 0 6px; color: #ffffff; font-weight: 700; }
  .card-header .sub { color: #e2e8f0; opacity: 0.9; margin: 0; font-size: .92rem; }
  .bar { height: 6px; background: rgba(255,255,255,0.25); border-radius: 4px; overflow: hidden; margin-top: 14px; }
  .bar > i { display: block; height: 100%; width: 0; background: #4fd1c5; transition: width .25s ease; border-radius: 4px; box-shadow: 0 0 8px rgba(79,209,197,0.6); }
  .card-body { padding: 28px 26px 32px; }
  label { display: block; font-size: .88rem; font-weight: 600; margin: 14px 0 6px; color: var(--text); }
  input, select {
    width: 100%; padding: 11px 13px; font-size: .98rem;
    border: 1.5px solid var(--line); border-radius: 8px;
    background: var(--card); color: var(--text); outline: none;
    transition: border-color .2s, box-shadow .2s;
  }
  input:focus, select:focus {
    border-color: var(--brand-focus);
    box-shadow: 0 0 0 3px rgba(79, 209, 197, 0.25);
  }
  .code-input { letter-spacing: .5em; text-align: center; font-size: 1.45rem; font-weight: 700; }
  .preview { margin-top: 12px; max-width: 100%; max-height: 240px; border-radius: 8px; display: none; border: 1.5px solid var(--line); }
  .note {
    font-size: .9rem; color: var(--muted); margin: 8px 0 14px; line-height: 1.45;
    background: rgba(79, 209, 197, 0.08); border-left: 3px solid var(--brand);
    padding: 9px 12px; border-radius: 4px;
  }
  .err { color: var(--err); font-size: .82rem; min-height: 1em; margin-top: 4px; }
  .banner {
    display: none; background: var(--err-bg); border: 1.5px solid var(--err-border);
    color: var(--err); padding: 11px 14px; border-radius: 8px; margin: 14px 0;
    font-size: .9rem; font-weight: 500;
  }
  .banner.success { background: #e6fffa; border-color: #38b2ac; color: #234e52; }
  button { font: inherit; padding: 12px 20px; border-radius: 8px; border: 0; cursor: pointer; font-weight: 600; }
  .primary {
    display: block; width: 100%; margin-top: 20px;
    background: var(--brand-gradient); color: #fff;
    box-shadow: 0 4px 14px rgba(56, 178, 172, 0.35);
    transition: box-shadow .2s, transform .1s; font-size: 1rem;
  }
  .primary:hover { box-shadow: 0 6px 18px rgba(56, 178, 172, 0.45); }
  .primary:active { transform: scale(0.99); }
  .primary:disabled { opacity: .6; cursor: wait; }
  .link {
    background: none; color: var(--brand); padding: 0;
    text-decoration: none; font-weight: 600; cursor: pointer; font-size: .88rem; border: 0;
  }
  .link:hover { text-decoration: underline; color: var(--brand-hover); }
  .login-footer { text-align: center; margin-top: 20px; font-size: .9rem; color: var(--muted); }
  .login-footer a { color: var(--brand); text-decoration: none; font-weight: 600; }
  .login-footer a:hover { text-decoration: underline; }
  .forgot-link { text-align: right; margin-top: 6px; }
  section { display: none; }
  section.active { display: block; }
</style>

<div class="wrap">
  <div class="card">
    <div class="card-header">
      <div class="logo">Cha<span>ma</span></div>
      <h1 id="authTitle">Personal Account Login</h1>
      <p class="sub" id="authSubtitle">Sign in to access your Chama dashboard</p>
      <!-- Progress bar — only visible during activation steps 5-8 -->
      <div class="bar" id="activationBar" style="display:none;"><i id="barFill"></i></div>
    </div>

    <div class="card-body">

      <div class="banner" id="banner" role="alert"></div>

      {{!-- ── SECTION A: NORMAL LOGIN ── --}}
      <section id="loginSection" class="active">
        <form id="loginForm" method="POST" action="/login">
          <label for="loginEmail">Email Address</label>
          <input id="loginEmail" name="email" type="email"
                 autocomplete="username"
                 placeholder="name@example.com"
                 value="{{formData.email}}">
          {{#if errors.email}}<p class="err">{{errors.email}}</p>{{/if}}

          <label for="loginPw">Password</label>
          <input id="loginPw" name="password" type="password"
                 autocomplete="current-password"
                 placeholder="Enter your password">
          {{#if errors.password}}<p class="err">{{errors.password}}</p>{{/if}}

          <div class="forgot-link">
            <a href="#" class="link" id="forgotToggle">Forgot Password?</a>
          </div>

          <button type="submit" class="primary" id="loginBtn">Log In</button>
        </form>

        <div class="login-footer">
          Don't have an account? <a href="/register">Create one</a>
        </div>
      </section>

      {{!-- ── SECTION B: FORGOT PASSWORD — ENTER CODE ── --}}
      <section id="codeSection">
        <p class="note">A shortcode will be sent to your email to reset your PIN</p>

        <label for="resetEmail">Email Address</label>
        <input id="resetEmail" type="email" placeholder="name@example.com" autocomplete="email">

        <label for="resetCode">Enter Code</label>
        <input id="resetCode" class="code-input" inputmode="numeric" maxlength="6" value="123456" placeholder="123456">

        <button type="button" class="primary" id="codeNextBtn">Enter</button>

        <div style="text-align: center; margin-top: 16px;">
          <a href="#" class="link" id="backToLoginFromCode">← Back to Sign In</a>
        </div>
      </section>

      {{!-- ── SECTION C: FORGOT PASSWORD — CREATE NEW PASSWORD ── --}}
      <section id="passwordSection">
        <label for="newPw">Create New Password / PIN</label>
        <input id="newPw" type="password" placeholder="Enter new password" autocomplete="new-password">

        <label for="confirmPw">Confirm Password / PIN</label>
        <input id="confirmPw" type="password" placeholder="Confirm new password" autocomplete="new-password">

        <button type="button" class="primary" id="resetSubmitBtn">Submit</button>

        <div style="text-align: center; margin-top: 16px;">
          <a href="#" class="link" id="backToCodeFromPw">← Back</a>
        </div>
      </section>

      {{!-- ── SECTION D: STEP 5 — VERIFY EMAIL CODE ── --}}
      <section id="emailCodeSection">
        <h2 style="font-size:1.15rem;margin:0 0 14px;color:var(--navy);font-weight:700;border-bottom:1.5px solid var(--line);padding-bottom:10px;">Account Activation: Email</h2>
        <p class="note">Enter the 6-digit code sent to your email address.</p>
        <input id="emailCode" class="code-input" inputmode="numeric" maxlength="6">
        <p style="margin-top:10px;"><button type="button" class="link" id="resendEmailBtn">Resend code</button></p>
        <button type="button" class="primary" id="emailCodeNextBtn">Next</button>
      </section>

      {{!-- ── SECTION E: STEP 6 — VERIFY PHONE CODE ── --}}
      <section id="phoneCodeSection">
        <h2 style="font-size:1.15rem;margin:0 0 14px;color:var(--navy);font-weight:700;border-bottom:1.5px solid var(--line);padding-bottom:10px;">Account Activation: Phone</h2>
        <p class="note">Enter the 6-digit code sent to your phone number by SMS.</p>
        <input id="phoneCode" class="code-input" inputmode="numeric" maxlength="6">
        <p style="margin-top:10px;"><button type="button" class="link" id="resendPhoneBtn">Resend code</button></p>
        <button type="button" class="primary" id="phoneCodeNextBtn">Next</button>
      </section>

      {{!-- ── SECTION F: STEP 7 — UPLOAD PASSPORT PHOTO ── --}}
      <section id="passportSection">
        <h2 style="font-size:1.15rem;margin:0 0 14px;color:var(--navy);font-weight:700;border-bottom:1.5px solid var(--line);padding-bottom:10px;">Upload your Passport Photo</h2>
        <input id="passportFile" type="file" accept="image/*">
        <img id="passportPrev" class="preview" alt="Passport photo preview">
        <button type="button" class="primary" id="passportNextBtn">Next</button>
      </section>

      {{!-- ── SECTION G: STEP 8 — UPLOAD NATIONAL ID ── --}}
      <section id="nationalIdSection">
        <h2 style="font-size:1.15rem;margin:0 0 14px;color:var(--navy);font-weight:700;border-bottom:1.5px solid var(--line);padding-bottom:10px;">Upload your National ID</h2>
        <input id="nationalIdFile" type="file" accept="image/*">
        <img id="nationalIdPrev" class="preview" alt="National ID preview">
        <button type="button" class="primary" id="nationalIdNextBtn">Finish &amp; Activate</button>
      </section>

    </div>
  </div>
</div>

<script>
(function () {
  const $ = id => document.getElementById(id);
  const emailRx = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const HOME_URL = '/dashboard';
  let token = sessionStorage.getItem('chama_token') || '';

  // ── Activation step order & progress bar ──
  const ACT_STEPS = ['emailCodeSection','phoneCodeSection','passportSection','nationalIdSection'];
  let actStep = 0;

  function setBar(stepIndex) {
    $('activationBar').style.display = 'block';
    $('barFill').style.width = ((stepIndex + 1) / ACT_STEPS.length * 100) + '%';
  }

  // ── Banner helpers ──
  function showBanner(msg, isSuccess) {
    const b = $('banner');
    b.textContent = msg;
    b.style.display = 'block';
    isSuccess ? b.classList.add('success') : b.classList.remove('success');
  }
  function hideBanner() {
    const b = $('banner');
    b.style.display = 'none';
    b.classList.remove('success');
  }

  // ── Section switcher ──
  const ALL_SECTIONS = [
    'loginSection','codeSection','passwordSection',
    'emailCodeSection','phoneCodeSection','passportSection','nationalIdSection'
  ];
  function showSection(id, title, subtitle) {
    hideBanner();
    ALL_SECTIONS.forEach(s => $(s).classList.remove('active'));
    $(id).classList.add('active');
    if (title) $('authTitle').textContent = title;
    if (subtitle) $('authSubtitle').textContent = subtitle;
    // Hide progress bar unless it's an activation step
    if (!ACT_STEPS.includes(id)) $('activationBar').style.display = 'none';
  }

  // ── API helper ──
  async function api(path, body, isForm) {
    const headers = token ? { Authorization: 'Bearer ' + token } : {};
    if (!isForm) headers['Content-Type'] = 'application/json';
    const res = await fetch('/api/auth' + path, {
      method: 'POST', headers,
      body: isForm ? body : JSON.stringify(body || {})
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || data.message || 'Something went wrong. Try again.');
    return data;
  }

  // ═══════════════════════════════════════════════
  // ON PAGE LOAD — check if coming from registration
  // ═══════════════════════════════════════════════
  window.addEventListener('DOMContentLoaded', async () => {
    const pendingEmail = sessionStorage.getItem('pendingEmail');
    if (!pendingEmail) return; // normal login, nothing to do

    // Pre-fill login email in case user needs it later
    $('loginEmail').value = pendingEmail;

    try {
      // Check which collection the email belongs to
      const res = await fetch('/api/auth/check-account-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: pendingEmail })
      });
      const data = await res.json().catch(() => ({}));

      if (data.status === 'pending') {
        // Found in pendingverifiedaccount → show activation steps
        token = data.token || token;
        if (data.token) sessionStorage.setItem('chama_token', token);
        startActivation();
      } else if (data.status === 'registered') {
        // Found in users → already fully registered, go to dashboard
        location.href = HOME_URL;
      } else {
        // Not found anywhere — show normal login
        sessionStorage.removeItem('pendingEmail');
      }
    } catch (e) {
      // Network error — show normal login silently
      sessionStorage.removeItem('pendingEmail');
    }
  });

  function startActivation() {
    actStep = 0;
    showSection('emailCodeSection', 'Account Activation', 'Complete the remaining steps to activate your account');
    setBar(0);
    // Auto-send email verification code
    api('/send-code', { channel: 'email' })
      .then(r => { if (r && r.demoCode) $('emailCode').value = r.demoCode; })
      .catch(() => {});
  }

  // ═══════════════════════════════════════════════
  // STEP 5 — Email Code
  // ═══════════════════════════════════════════════
  $('emailCodeNextBtn').onclick = async function () {
    const code = $('emailCode').value.trim();
    if (!/^\d{6}$/.test(code)) return showBanner('Enter the 6-digit code.');
    this.disabled = true; this.textContent = 'Verifying…';
    try {
      await api('/verify-code', { channel: 'email', code })
        .catch(() => api('/verify-email', { code }));
      // Send phone code
      const r = await api('/send-code', { channel: 'phone' }).catch(() => ({}));
      if (r && r.demoCode) $('phoneCode').value = r.demoCode;
      actStep = 1;
      showSection('phoneCodeSection', 'Account Activation', 'Step 2 of 4 — Phone Verification');
      setBar(1);
    } catch (e) { showBanner(e.message); }
    finally { this.disabled = false; this.textContent = 'Next'; }
  };

  $('resendEmailBtn').onclick = async function () {
    try {
      await api('/send-code', { channel: 'email' }).catch(() => api('/resend-code', { channel: 'email' }));
      this.textContent = 'Code sent';
      setTimeout(() => this.textContent = 'Resend code', 4000);
    } catch (e) { showBanner(e.message); }
  };

  // ═══════════════════════════════════════════════
  // STEP 6 — Phone Code
  // ═══════════════════════════════════════════════
  $('phoneCodeNextBtn').onclick = async function () {
    const code = $('phoneCode').value.trim();
    if (!/^\d{6}$/.test(code)) return showBanner('Enter the 6-digit code.');
    this.disabled = true; this.textContent = 'Verifying…';
    try {
      await api('/verify-code', { channel: 'phone', code })
        .catch(() => api('/verify-phone', { code }));
      actStep = 2;
      showSection('passportSection', 'Account Activation', 'Step 3 of 4 — Passport Photo');
      setBar(2);
    } catch (e) { showBanner(e.message); }
    finally { this.disabled = false; this.textContent = 'Next'; }
  };

  $('resendPhoneBtn').onclick = async function () {
    try {
      await api('/send-code', { channel: 'phone' }).catch(() => api('/resend-code', { channel: 'phone' }));
      this.textContent = 'Code sent';
      setTimeout(() => this.textContent = 'Resend code', 4000);
    } catch (e) { showBanner(e.message); }
  };

  // ═══════════════════════════════════════════════
  // STEP 7 — Passport Photo
  // ═══════════════════════════════════════════════
  $('passportFile').onchange = function (e) {
    const f = e.target.files[0]; if (!f) return;
    $('passportPrev').src = URL.createObjectURL(f);
    $('passportPrev').style.display = 'block';
  };

  $('passportNextBtn').onclick = async function () {
    if (!$('passportFile').files[0]) return showBanner('Please choose a passport photo.');
    this.disabled = true; this.textContent = 'Uploading…';
    try {
      const f = new FormData();
      f.append('passportPhoto', $('passportFile').files[0]);
      f.append('file', $('passportFile').files[0]);
      await api('/upload/passport', f, true)
        .catch(() => fetch('/api/kyc/passport-photo', {
          method: 'POST', headers: { Authorization: 'Bearer ' + token }, body: f
        }).then(r => r.json()));
      actStep = 3;
      showSection('nationalIdSection', 'Account Activation', 'Step 4 of 4 — National ID');
      setBar(3);
    } catch (e) { showBanner(e.message); }
    finally { this.disabled = false; this.textContent = 'Next'; }
  };

  // ═══════════════════════════════════════════════
  // STEP 8 — National ID → Done → Dashboard
  // ═══════════════════════════════════════════════
  $('nationalIdFile').onchange = function (e) {
    const f = e.target.files[0]; if (!f) return;
    $('nationalIdPrev').src = URL.createObjectURL(f);
    $('nationalIdPrev').style.display = 'block';
  };

  $('nationalIdNextBtn').onclick = async function () {
    if (!$('nationalIdFile').files[0]) return showBanner('Please choose a photo of your National ID.');
    this.disabled = true; this.textContent = 'Activating…';
    try {
      const f = new FormData();
      f.append('idFront', $('nationalIdFile').files[0]);
      f.append('file', $('nationalIdFile').files[0]);
      await api('/upload/national-id', f, true)
        .catch(() => fetch('/api/kyc/national-id', {
          method: 'POST', headers: { Authorization: 'Bearer ' + token }, body: f
        }).then(r => r.json()));
      // Clear pending state and go to dashboard
      sessionStorage.removeItem('pendingEmail');
      sessionStorage.removeItem('chama_token');
      location.href = HOME_URL;
    } catch (e) {
      showBanner(e.message);
      this.disabled = false; this.textContent = 'Finish & Activate';
    }
  };

  // ═══════════════════════════════════════════════
  // FORGOT PASSWORD FLOW
  // ═══════════════════════════════════════════════
  $('forgotToggle').onclick = function (e) {
    e.preventDefault();
    const loginEmailVal = $('loginEmail').value.trim();
    if (loginEmailVal) $('resetEmail').value = loginEmailVal;
    $('resetCode').value = '123456';
    showSection('codeSection', 'Reset Your PIN', 'Enter the verification code');
    $('resetCode').focus();
    $('resetCode').select();
  };

  $('backToLoginFromCode').onclick = function (e) {
    e.preventDefault();
    showSection('loginSection', 'Personal Account Login', 'Sign in to access your Chama dashboard');
  };

  $('backToCodeFromPw').onclick = function (e) {
    e.preventDefault();
    showSection('codeSection', 'Reset Your PIN', 'Enter the verification code');
  };

  function handleCodeNext() {
    const email = $('resetEmail').value.trim();
    const code = $('resetCode').value.trim();
    if (!email || !emailRx.test(email)) return showBanner('Please enter a valid email address.');
    if (!code || !/^\d{4,6}$/.test(code)) return showBanner('Please enter the 6-digit verification code.');
    showSection('passwordSection', 'Create New Password', 'Enter and confirm your new password/PIN');
    $('newPw').focus();
  }

  $('codeNextBtn').onclick = handleCodeNext;
  $('resetCode').addEventListener('keydown', e => { if (e.key === 'Enter') handleCodeNext(); });
  $('resetEmail').addEventListener('keydown', e => { if (e.key === 'Enter') handleCodeNext(); });

  async function handleResetSubmit() {
    const email = $('resetEmail').value.trim();
    const code = $('resetCode').value.trim();
    const newPassword = $('newPw').value;
    const confirmPassword = $('confirmPw').value;
    if (!newPassword) return showBanner('Please enter your new password/PIN.');
    if (newPassword.length < 4) return showBanner('Password/PIN must be at least 4 characters.');
    if (newPassword !== confirmPassword) return showBanner('Passwords do not match.');
    $('resetSubmitBtn').disabled = true;
    $('resetSubmitBtn').textContent = 'Updating PIN…';
    try {
      const res = await fetch('/api/auth/reset-pin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email.toLowerCase(), code, newPassword })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || data.message || 'Failed to update PIN. Please try again.');
      showSection('loginSection', 'Personal Account Login', 'Sign in to access your Chama dashboard');
      $('loginEmail').value = email;
      $('loginPw').value = newPassword;
      showBanner(data.message || 'PIN updated successfully! You can now log in.', true);
    } catch (err) {
      showBanner(err.message);
    } finally {
      $('resetSubmitBtn').disabled = false;
      $('resetSubmitBtn').textContent = 'Submit';
    }
  }

  $('resetSubmitBtn').onclick = handleResetSubmit;
  $('confirmPw').addEventListener('keydown', e => { if (e.key === 'Enter') handleResetSubmit(); });
  $('newPw').addEventListener('keydown', e => { if (e.key === 'Enter') handleResetSubmit(); });

  // ═══════════════════════════════════════════════
  // NORMAL LOGIN SUBMIT
  // ═══════════════════════════════════════════════
  $('loginForm').onsubmit = function (e) {
    const email = $('loginEmail').value.trim();
    const pw = $('loginPw').value;
    if (!emailRx.test(email)) { e.preventDefault(); return showBanner('Enter a valid email address.'); }
    if (!pw) { e.preventDefault(); return showBanner('Enter your password.'); }
    $('loginBtn').disabled = true;
    $('loginBtn').textContent = 'Signing in…';
  };

  ['loginEmail', 'loginPw'].forEach(id => {
    $(id).addEventListener('keydown', e => {
      if (e.key === 'Enter') $('loginForm').requestSubmit();
    });
  });

})();
</script>
